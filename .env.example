# このファイルを .env という名前でコピーして、APIキーを書き込んでください。
#   cp .env.example .env
# .env は .gitignore 済みなので GitHub にはアップロードされません。
# すべて空欄のままでも「モックモード」で動画を作れます（無料）。

# ===== 動作モード =====
# auto: APIキーがあるものは本番API、無いものはモック / mock: すべてモック（無料）
HR_MODE=auto
# true にすると、APIエラー時にモックへ切り替えず停止します
HR_STRICT=false

# ===== Claude（企画・台本・ファクトチェック）=====
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high（高いほど丁寧だが費用・時間が増える）
CLAUDE_EFFORT=medium
# Web検索で事実確認する（推奨: true）
FACTCHECK_WEB_SEARCH=true

# ===== OpenAI（画像生成・音声合成）=====
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=
# auto / openai / mock
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
# low / medium / high
IMAGE_QUALITY=medium
# auto / ai（背景もAI生成）/ procedural（背景はプログラム描画で節約）
BACKGROUND_MODE=auto

# ===== 音声 =====
# auto / openai / voicevox / mock
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# VOICEVOX を使う場合（無料）: エンジンを起動して URL を設定
# 例) docker run -d -p 50021:50021 voicevox/voicevox_engine:cpu-latest
VOICEVOX_URL=
VOICEVOX_SPEAKER=13
VOICEVOX_CREDIT=VOICEVOX:青山龍星
BGM_ENABLED=true

# ===== 動画・投稿 =====
MIN_SECONDS=20
MAX_SECONDS=35
# 日本語フォントのパス（空欄なら自動検出。assets/fonts/ に置いてもOK）
FONT_PATH=
# 投稿用ハッシュタグの数
HASHTAG_LIMIT=5
ACCOUNT_HANDLE=@waseda.jyukengoukaku

# ===== 将来の Instagram 自動投稿用（今は未使用）=====
# IG_ACCESS_TOKEN=
# IG_USER_ID=
