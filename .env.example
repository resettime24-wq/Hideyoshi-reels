# このファイルを .env という名前でコピーして、APIキーを書き込んでください。
#   cp .env.example .env
# .env は .gitignore 済みなので GitHub にはアップロードされません。
# すべて空欄のままでも「モックモード」で投稿画像・リール動画を作れます（無料）。

# ===== 動作モード =====
# auto: APIキーがあるものは本番API、無いものはモック / mock: すべてモック（無料）
HR_MODE=auto
# true にすると、APIエラー時にモックへ切り替えず停止します
HR_STRICT=false

# ===== 投稿形式・デザイン =====
# reel: 1080×1920の静止画1枚を10秒表示するMP4 / feed: 1080×1350の画像1枚 / carousel: 1080×1350の複数枚
POST_FORMAT=reel
# auto: 投稿テーマに合わせて自動選択 / A: 黒×金 強フック / B: 赤×金 ランキング
# C: 白×紺 インフォグラフィック / D: 和紙×緑 行動チェックリスト
DESIGN_STYLE=auto
REEL_SECONDS=10
CAROUSEL_MAX_SLIDES=6

# ===== Claude（Trend: トレンド分析・企画・原稿・事実確認 / Monetization）=====
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high（高いほど丁寧だが費用・時間が増える）
CLAUDE_EFFORT=medium
TREND_WEB_SEARCH=true
FACTCHECK_WEB_SEARCH=true

# ===== OpenAI（キャラクター画像の生成・任意）=====
# 未設定の場合は、プログラムで描いた仮のオリジナルキャラを使います
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium

# ===== 収益化（Monetization）=====
# 有料noteなどのURL。空欄の間はキャプションにリンク誘導を入れません
NOTE_URL=
# true にするとアフィリエイト導線を前提に、キャプション冒頭へ【PR】表記を入れます
AFFILIATE_ENABLED=false

# ===== その他 =====
# 日本語フォントのパス（空欄なら自動検出。assets/fonts/black.ttf などに置いてもOK）
FONT_PATH=
HASHTAG_LIMIT=5
ACCOUNT_HANDLE=@waseda.jyukengoukaku

# ===== 将来の Instagram 自動投稿用（今は未使用）=====
# IG_ACCESS_TOKEN=
# IG_USER_ID=
